# ---- Frontend (Vite) — exposed to the browser ----
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ---- Serverless functions (api/create-student.js, api/student-login.js) ----
# SECRET. Never expose these to the browser and never commit them.
#
# FIREBASE_PROJECT_ID is optional: it is reused from VITE_FIREBASE_PROJECT_ID.
# FIREBASE_API_KEY is optional: it is reused from VITE_FIREBASE_API_KEY.
#
# Easiest local setup:
#   1. Firebase Console -> Project Settings -> Service Accounts ->
#      "Generate new private key"
#   2. Save the downloaded file as scripts/service-account.json (git-ignored)
#   3. Run: npm run check:firebase            (report)
#           npm run check:firebase -- --write (fill in the values below)
#
# You can also paste the whole JSON as one variable instead of the two below:
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Firebase Web API key (used server-side only by api/student-login.js to verify
# the student password against Firebase Authentication). Same value as
# VITE_FIREBASE_API_KEY.
FIREBASE_API_KEY=your_api_key_here
